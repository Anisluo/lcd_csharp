<Window x:Class="MockDev.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mockDev — LCD 硬件仿真 (虚拟串口仪器)" Height="560" Width="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- setupc 路径 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="com0com setupc:" Width="110" VerticalAlignment="Center"/>
            <Button x:Name="DetectBtn" Content="自动检测" Width="70" DockPanel.Dock="Right" Margin="6,0,0,0" Click="DetectBtn_Click"/>
            <Button x:Name="BrowseBtn" Content="浏览…" Width="60" DockPanel.Dock="Right" Click="BrowseBtn_Click"/>
            <TextBox x:Name="SetupcBox" VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- 端口 -->
        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock Text="LCD 端口:" Width="110" VerticalAlignment="Center"/>
            <TextBox x:Name="LcdPortBox" Text="COM20" Width="90" VerticalContentAlignment="Center"/>
            <TextBlock Text="  ↔  mockDev 端口:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="MockPortBox" Text="COM21" Width="90" VerticalContentAlignment="Center" Margin="6,0,0,0"/>
            <TextBlock Text="  （LCD 的 Config.xml 里 comName 填左边这个）" VerticalAlignment="Center" Foreground="Gray"/>
        </DockPanel>

        <!-- 仪器 -->
        <DockPanel Grid.Row="2" Margin="0,0,0,6">
            <TextBlock Text="模拟仪器:" Width="110" VerticalAlignment="Center"/>
            <ComboBox x:Name="InstrumentBox" Width="160" DisplayMemberPath="Name" SelectionChanged="InstrumentBox_SelectionChanged"/>
            <TextBlock Text="  波特率:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="BaudBox" Text="9600" Width="80" VerticalContentAlignment="Center" Margin="6,0,0,0"/>
        </DockPanel>

        <!-- 按钮 -->
        <DockPanel Grid.Row="3" Margin="0,4,0,6">
            <Button x:Name="StartBtn" Content="▶ 开始 (建虚拟串口对并模拟)" Width="230" Height="30" Click="StartBtn_Click"/>
            <Button x:Name="StopBtn" Content="■ 停止 (删除虚拟串口对)" Width="200" Height="30" Margin="10,0,0,0" IsEnabled="False" Click="StopBtn_Click"/>
        </DockPanel>

        <!-- 状态 -->
        <TextBlock x:Name="StatusText" Grid.Row="4" Text="就绪。" Margin="0,0,0,6" Foreground="#0066CC"/>

        <!-- 日志 -->
        <TextBox x:Name="LogBox" Grid.Row="5" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"/>
    </Grid>
</Window>
