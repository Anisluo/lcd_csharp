<Window x:Class="LCD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LCD"
        xmlns:hc="clr-namespace:LCD.Themes"
        mc:Ignorable="d"
        Closing="Window_Closing"
        Closed="Window_Closed"
               xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Background="White"
        Title="LCD辉度自动测试系统" Height="740" Width="1350" Loaded="Window_Loaded" >

    <!--<Window.Resources>
        <ContextMenu x:Key="ContextMenu">
            <MenuItem Name="ShowAll" Header="显示全部" Click="MenuItem_OnClick"/>
            <Separator></Separator>
            <MenuItem Name="ShowPortion" Header="显示部分" Click="ShowPortion"/>
        </ContextMenu>
    </Window.Resources>-->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="35"/>
            <RowDefinition/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right">
            <Image Source="Image/head.png"/>
        </WrapPanel>

        <Menu  HorizontalAlignment="Left" Background="Transparent" VerticalAlignment="Center">
            <MenuItem Header="文件（F）">
                <MenuItem Header="打开" Click="Open_OnClick"></MenuItem>
                <MenuItem Header="关闭" Click="Close_Click"></MenuItem>
                <!--<MenuItem Header="导出CSV"></MenuItem>-->
                <MenuItem Header="历史记录" Click="OnBnClickedHistory"></MenuItem>
                <!--<MenuItem Header="图像"></MenuItem>-->
            </MenuItem>
            <MenuItem Header="参数（P）">
                <MenuItem Header="仪器设定" Click="OnBnClickedDevice"></MenuItem>
                <MenuItem Header="视场角设置" Click="OnBnClickedFdl"></MenuItem>
                <MenuItem Name="MPcItemMenuItem" Header="平台设定" Click="OnBnClickMPC"></MenuItem>
                <MenuItem Header="运动模式" Click="OnBnClickMoveStyle"></MenuItem>
                <MenuItem Header="相机设置" Click="OnBnClickCamera"></MenuItem>
                <MenuItem Header="响应仪器配置" Click="OnBnClickedResp"></MenuItem>
                <MenuItem Header="PG配置" Click="OnBnClickedPGView"></MenuItem>
                <MenuItem Header="电源设置"
                          Click="MenuItem_PowerClick"></MenuItem>
                <MenuItem Header="数据格式配置" Click="OnBnClickedResultFormat"></MenuItem>
                <MenuItem Header="回零"
                          x:Name="CenterMenuitem"
                          Click="OnBnClicked2Center" />
                <MenuItem Header="上料位置" Click="MenuItem_OnClickup"/>
            </MenuItem>
            <!--<MenuItem Header="测量（M）">
                <MenuItem Header="单点测量"></MenuItem>
                <MenuItem Header="多点测量"></MenuItem>
            </MenuItem>-->

            <!--<MenuItem Header="模板（T）">
                <MenuItem Header="5点模板" Click="OnBnClicked5PointView"></MenuItem>
                <MenuItem Header="9点模板" Click="OnBnClicked9PointView"></MenuItem>
                <MenuItem Header="13点模板" Click="OnBnClicked13PointView"></MenuItem>
                <MenuItem Header="点位模板" Click="OnBnClickedCustomTemplate"></MenuItem>
                <MenuItem Header="响应模板" Click="OnBnClickedResponseTemplate"></MenuItem>
                <MenuItem Header="自定义模板组" Click="OnBnClickedCustomView" ></MenuItem>
            </MenuItem>-->

            <!--<MenuItem Header="报表（R）">
                <MenuItem Header="单次报表"></MenuItem>
                <MenuItem Header="多次报表"></MenuItem>
            </MenuItem>-->
            <MenuItem Header="帮助（H）">
                <MenuItem Header="操作手册"></MenuItem>
                <MenuItem Header="设备自诊断" Click="OnBnClickedSelfCheck"></MenuItem>
            </MenuItem>
        </Menu>

        <TextBlock Visibility="Collapsed" Grid.Row="1" Margin="0,0,360,0" VerticalAlignment="Center" Width="120" FontSize="24" Background="Red" TextAlignment="Center" Text="正常" HorizontalAlignment="Right"/>

        <WrapPanel Grid.Row="1" VerticalAlignment="Center">
            <Button  Width="30" Height="28" Margin="10,0,0,0" BorderBrush="Transparent" Background="Transparent" BorderThickness="0" Click="OnBnClickedSwitchUser" VerticalAlignment="Center" >
                <svgc:SvgViewbox Source="Image\user.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
            </Button>

            <Button  Width="30" Height="28" Margin="10,0,0,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Click="OnBnClickedStop" VerticalAlignment="Center" >
                <svgc:SvgViewbox Source="Image\run.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
            </Button>


            <Button  Width="30" Height="28" Margin="10,0,0,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Click="OnBnClickedHistory" VerticalAlignment="Center" >
                <svgc:SvgViewbox Source="Image\Stop.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
            </Button>

            <Button  Width="30" Height="28" Margin="10,0,0,0" Background="Transparent" BorderBrush="Transparent" Click="OnBnClickedHistory" VerticalAlignment="Center" >
                <svgc:SvgViewbox Source="Image\history.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
            </Button>

            <Button  Width="30" Height="28" Margin="10,0,0,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Click="OnBnClickedHistory" VerticalAlignment="Center" >
                <svgc:SvgViewbox Source="Image\template.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
            </Button>

            <!--<Button  Width="30" Height="28" Margin="0,0,0,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" FontSize="16" Content="2°" Click="OnBnClickedHistory" VerticalAlignment="Center"/>
            <Button  Width="30" Height="28" Margin="2,0,0,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" FontSize="16" Content="1°" Click="OnBnClickedHistory" VerticalAlignment="Center" />
            <Button  Width="30" Height="28" Margin="2,0,0,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" FontSize="16" Content="0.2°" Click="OnBnClickedHistory" VerticalAlignment="Center"/>
            <Button  Width="30" Height="28" Margin="2,0,0,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" FontSize="16" Content="0.1°" Click="OnBnClickedHistory" VerticalAlignment="Center"/>-->

            <Button  Width="30" Height="28" Margin="10,0,0,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Click="OnBnClickedClear" VerticalAlignment="Center" >
                <svgc:SvgViewbox Source="Image\clear.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
            </Button>
            <Button Visibility="Collapsed" Content="测试" Margin="1" Style="{StaticResource ButtonBaseStyle}" hc:IconElement.Geometry="{StaticResource PlayGeometry}" hc:IconElement.Height="12" Foreground="Black" BorderThickness="1"/>
            <Button Visibility="Collapsed" Content="暂停" Margin="1" Style="{StaticResource ButtonBaseStyle}" hc:IconElement.Geometry="{StaticResource PauseGeometry}" hc:IconElement.Height="12" Foreground="Black" BorderThickness="1"/>
            <Button Visibility="Collapsed" Content="停止" Margin="1" Style="{StaticResource ButtonBaseStyle}" hc:IconElement.Geometry="{StaticResource StopGeometry}" hc:IconElement.Height="12" Foreground="White" Background="DarkRed"/>


        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>
                <!--ContextMenu="{StaticResource ContextMenu}"-->
                <TabControl x:Name="ResTab" >

                    <TabItem>
                        <TabItem.ContextMenu>
                            <ContextMenu Name="Tab1Menu"  >
                                <MenuItem Header="显示全部" Click="MenuItem_OnClick"></MenuItem>
                                <MenuItem Header="显示部分" Click="ShowPortion"></MenuItem>
                            </ContextMenu>
                        </TabItem.ContextMenu>
                        <TabItem.Header >
                            <svgc:SvgViewbox Height="24" 
                            Width="40" Source="Image\results.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                        </TabItem.Header>
                        <TabItem.Content>
                            <ContentControl Name="Result" Background="White" >
                            </ContentControl>
                        </TabItem.Content>
                    </TabItem>
                    <TabItem>
                        <TabItem.ContextMenu>
                            <ContextMenu Name="Tab1Menu1"  >
                                <MenuItem Header="显示全部" Click="spectrumResult"></MenuItem>
                                <MenuItem Header="显示部分" Click='spectrumResultFalse'></MenuItem>
                            </ContextMenu>
                        </TabItem.ContextMenu>
                        <TabItem.Header >
                            <svgc:SvgViewbox Height="24" 
                            Width="40" Source="Image\results.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                        </TabItem.Header>
                        <TabItem.Content>
                            <ContentControl Name="SpectrumResults" Background="White">
                            </ContentControl>
                        </TabItem.Content>
                    </TabItem>
                    <TabItem>
                        <TabItem.ContextMenu>
                            <ContextMenu Name="Tab1Menu3"  >
                                <MenuItem Header="显示全部" Click='warmupResultOK'></MenuItem>
                                <MenuItem Header="显示部分" Click="warmupResultFalse"></MenuItem>
                            </ContextMenu>
                        </TabItem.ContextMenu>
                        <TabItem.Header >
                            <svgc:SvgViewbox Height="24" 
                            Width="40" Source="Image\results.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                        </TabItem.Header>
                        <TabItem.Content>
                            <ContentControl Name="warmup" Background="White">
                            </ContentControl>
                        </TabItem.Content>
                    </TabItem>
                    <TabItem>
                        <TabItem.ContextMenu>
                            <ContextMenu Name="Tab1Menu4">
                                <MenuItem Header="显示全部"
                                          Click='warmupResultOK'></MenuItem>
                                <MenuItem Header="显示部分"
                                          Click="warmupResultFalse"></MenuItem>
                            </ContextMenu>
                        </TabItem.ContextMenu>
                        <TabItem.Header>
                            <svgc:SvgViewbox Height="24"
                                             Width="40"
                                             Source="Image\results.svg"
                                             IsHitTestVisible="False"></svgc:SvgViewbox>
                        </TabItem.Header>
                        <TabItem.Content>
                            <ContentControl Name="Power"
                                            Background="White">
                            </ContentControl>
                        </TabItem.Content>
                    </TabItem>
                    <TabItem >
                        <TabItem.Header >
                            <svgc:SvgViewbox Height="24" 
                            Width="40"
                                             Source="Image\histogram.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                        </TabItem.Header>

                        <TabItem.Content>
                            <ContentControl Name="Statics" Background="White">
                            </ContentControl>
                        </TabItem.Content>


                    </TabItem>

                    <TabItem>
                        <TabItem.Header >
                            <svgc:SvgViewbox Height="24" 
                            Width="40"
                                             Source="Image\curves.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                        </TabItem.Header>
                        <TabItem.Content>
                            <ContentControl Name="Waves" Background="White">
                            </ContentControl>
                        </TabItem.Content>

                    </TabItem>

                    

                </TabControl>

                <Grid Grid.Row="1" Name="mypanel" >
                    <Grid Background="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition Height="29"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button  Grid.Row="0" Grid.Column="1" 
                            BorderBrush="Transparent"
                            Height="40" Width="40"
                            Background="Transparent"
                                     x:Name="btnUP">

                                <svgc:SvgViewbox Source="Image\up.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                            </Button>
                            <Button Grid.Row="1"  x:Name="btnLeft" 
                            BorderBrush="Transparent"
                            Height="40" Width="40"
                            Background="Transparent">
                                <svgc:SvgViewbox Source="Image\left.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="2" 
                            Height="40" Width="40"
                            BorderBrush="Transparent"
                            Background="Transparent"
                                    x:Name="btnRight"  >
                                <svgc:SvgViewbox Source="Image\right.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                            </Button>
                            <Button Grid.Row="2"  Grid.Column="1"  
                            Height="40" Width="40"
                            Background="Transparent"
                            BorderBrush="Transparent"
                                    x:Name="btnDown"  >
                                <svgc:SvgViewbox Source="Image\down.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                            </Button>
                            <Button  Grid.Row="1" Grid.Column="1" 
                                     x:Name="btnZero" 
                                     Width="40" 
                                     Height="40" 
                                     Click="btnO_Click"
                            Background="Transparent"
                            BorderBrush="Transparent" >

                                <svgc:SvgViewbox Source="Image\zero.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                            </Button>

                            <Button  Grid.Row="0" Grid.Column="2"  
                            Height="40" Width="40"
                            BorderBrush="Transparent"
                            Background="Transparent"
                                     x:Name="btnIn"  >

                                <svgc:SvgViewbox Source="Image\sort-up.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="2"  
                            Width="40" Height="40"
                            Background="Transparent"
                            BorderBrush="Transparent"
                                    x:Name="btnOut"  >
                                <svgc:SvgViewbox Source="Image\sort-down.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                            </Button>

                            <WrapPanel Grid.Row="3"
                                       Grid.ColumnSpan="3"
                                       Orientation="Vertical"
                                       VerticalAlignment="Stretch"
                                       HorizontalAlignment="Stretch">

                                <!--<svgc:SvgViewbox Width="30"
                                                 Height="30"
                                                 Margin="0,0,10,0"
                                                 Source="Image\speedlabel.svg"
                                                 IsHitTestVisible="False"></svgc:SvgViewbox>-->
                                <ToggleButton Name="SpeelLow_1"
                                              Margin="2"
                                              FontWeight="Bold"
                                              BorderBrush="Transparent"
                                              Background="Transparent"
                                              Click="OnBnClickedSpeedLow_1"
                                              Height="25"
                                              Width="25">
                                    <svgc:SvgViewbox Source="Image\speed1.svg"
                                                     IsHitTestVisible="False"></svgc:SvgViewbox>
                                </ToggleButton>


                                <ToggleButton  FontSize="20"
                                               FontWeight="Bold"
                                               BorderBrush="Transparent"
                                               Background="Transparent"
                                               Name="SpeedMedium_1"
                                               Click="OnBnClickedSpeedMedium_1"
                                               Height="25"
                                               Width="25">
                                    <svgc:SvgViewbox Source="Image\speed2.svg"
                                                     IsHitTestVisible="False"></svgc:SvgViewbox>
                                </ToggleButton>

                                <ToggleButton  FontSize="20"
                                               FontWeight="Bold"
                                               BorderBrush="Transparent"
                                               Background="Transparent"
                                               Name="SpeedHigh_1"
                                               Click="OnBnClickedSpeedHigh_1"
                                               Height="25"
                                               Width="25">
                                    <svgc:SvgViewbox Source="Image\speed3.svg"
                                                     IsHitTestVisible="False"></svgc:SvgViewbox>
                                </ToggleButton>
                            </WrapPanel>

                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button  Grid.Row="0" Grid.Column="1"
                            Height="40" Width="40"
                            Background="Transparent"
                            MouseDown="URotatRight_MouseDown" MouseUp="URotatRight_MouseUp"
                            BorderBrush="Transparent"
                                     Name="btnURight" >
                                <svgc:SvgViewbox Source="Image\cwrotate.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="0" 
                            Height="40" Width="40"
                            Background="Transparent"
                            MouseDown="URotatLeft_MouseDown" MouseUp="URotatLeft_MouseUp"
                            BorderBrush="Transparent"
                                    x:Name="btnULeft">

                                <svgc:SvgViewbox Source="Image\acrotate.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="0" 
                            Background="Transparent"
                            BorderBrush="Transparent"
                            MouseDown="VRotatRight_MouseDown" MouseUp="VRotatRight_MouseUp"
                            Height="40" Width="40"
                                    x:Name="btnVRight" >

                                <svgc:SvgViewbox Source="Image\rotate-left.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="1" 
                            Height="40" Width="40"
                            MouseDown="VRotatLeft_MouseDown" MouseUp="VRotatLeft_MouseUp"
                            BorderBrush="Transparent"
                            Background="Transparent"
                                    x:Name="btnVLeft">

                                <svgc:SvgViewbox Source="Image\rotate-right.svg" IsHitTestVisible="False"></svgc:SvgViewbox>
                            </Button>
                            <Button 
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    Content="参考"
                                    x:Name="Button1"
                                    Click="Button1_OnClick"
                                    Style="{StaticResource ButtonBaseStyle}" />
                            <Button Grid.Row="2"
                                    Grid.Column="1"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    Content="修正"
                                    Click="Button2_OnClick"
                                    x:Name="Button2"
                                    Style="{StaticResource ButtonBaseStyle}" />
                            <WrapPanel Grid.Row="3"
                                       Grid.ColumnSpan="3"
                                       Orientation="Vertical"
                                       VerticalAlignment="Stretch"
                                       HorizontalAlignment="Stretch">

                                <!--<svgc:SvgViewbox Width="30"
                                                 Height="30"
                                                 Margin="0,0,10,0"
                                                 Source="Image\speedlabel.svg"
                                                 IsHitTestVisible="False"></svgc:SvgViewbox>-->
                                <ToggleButton Margin="2"
                                              FontWeight="Bold"
                                              BorderBrush="Transparent"
                                              Background="Transparent"
                                              Name="SpeedLow_2"
                                              Click="OnBnClickedSpeedLow_2"
                                              Height="25"
                                              Width="25">
                                    <svgc:SvgViewbox Source="Image\speed1.svg"
                                                     IsHitTestVisible="False"></svgc:SvgViewbox>
                                </ToggleButton>


                                <ToggleButton  FontSize="20"
                                               FontWeight="Bold"
                                               BorderBrush="Transparent"
                                               Background="Transparent"
                                               Name="SpeedMedium_2"
                                               Click="OnBnClickedSpeedMedium_2"
                                               Height="25"
                                               Width="25">
                                    <svgc:SvgViewbox Source="Image\speed2.svg"
                                                     IsHitTestVisible="False"></svgc:SvgViewbox>
                                </ToggleButton>

                                <ToggleButton  FontSize="20"
                                               FontWeight="Bold"
                                               BorderBrush="Transparent"
                                               Background="Transparent"
                                               Name="SpeedHigh_2"
                                               Click="OnBnClickedSpeedHigh_2"
                                               Height="25"
                                               Width="25">
                                    <svgc:SvgViewbox Source="Image\speed3.svg"
                                                     IsHitTestVisible="False"></svgc:SvgViewbox>
                                </ToggleButton>
                            </WrapPanel>
                        </Grid>

                        <Grid Grid.Column="3">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button x:Name="TempButton" Background="White" Width="90" Height="28" Click="OnBnClickedSelfTemplate" FontWeight="Bold" Content="测试模板" Style="{StaticResource ButtonBaseStyle}"/>
                            </WrapPanel>

                            <WrapPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button Background="White" Width="90" Click="OnBnClickReadSingleData" FontWeight="Bold" Height="28" Content="单点测量" Style="{StaticResource ButtonBaseStyle}"/>
                            </WrapPanel>

                            <WrapPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button Width="90" FontWeight="Bold" Height="28" Click="onBnClickSpecturm" Background="White" Content="光谱测量" Style="{StaticResource ButtonBaseStyle}"/>
                            </WrapPanel>

                            <WrapPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button Width="90" Content="复位" Click="Button_Click" Margin="1" Style="{StaticResource ButtonBaseStyle}" hc:IconElement.Geometry="{StaticResource ResetGeometry}" hc:IconElement.Height="12" Foreground="White" Background="#FF50A0FF"/>
                            </WrapPanel>
                        </Grid>


                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button  FontSize="20" 
                                FontWeight="Bold"
                                Background="Green"
                                Click="OnBnClickedStartRun"
                                        Height="50" Width="50">
                                    <svgc:SvgViewbox 
                                        Source="Image\run.svg" 
                                        IsHitTestVisible="False"></svgc:SvgViewbox>
                                </Button>
                            </WrapPanel>

                            <WrapPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button  FontSize="20" 
                                FontWeight="Bold"
                                Click="OnBnClickedFstStop"
                                Background="Red"
                                        Height="50" Width="50">
                                    <svgc:SvgViewbox 
                                        Source="Image\Stop.svg" 
                                        IsHitTestVisible="False"></svgc:SvgViewbox>
                                </Button>
                            </WrapPanel>
                        </Grid>


                        <Grid Grid.Column="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="AUto"/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            

                            <WrapPanel Background="Black" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="X轴：" Foreground="Green"></Label>
                                <TextBlock Width="80" FontSize="16" Name="XPos" Foreground="Green" ></TextBlock>
                            </WrapPanel>


                            <WrapPanel Background="Black" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="Y轴：" Foreground="Green"></Label>
                                <TextBlock Width="80" FontSize="16" Name="YPos" Foreground="Green"></TextBlock>
                            </WrapPanel>


                            <WrapPanel Background="Black" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="Z轴：" Foreground="Green"></Label>
                                <TextBlock Width="80" FontSize="16" Name="ZPos" Foreground="Green"></TextBlock>
                            </WrapPanel>
                        </Grid>


                        <Grid Grid.Column="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="AUto"/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            

                            <WrapPanel Background="Black" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="U轴：" Foreground="Green"></Label>
                                <TextBlock Width="80" FontSize="16" Name="UPos" Foreground="Green"></TextBlock>
                            </WrapPanel>


                            <WrapPanel Background="Black" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="V轴：" Foreground="Green"></Label>
                                <TextBlock Width="80" FontSize="16" Name="VPos" Foreground="Green"></TextBlock>
                            </WrapPanel>


                            <WrapPanel Background="Black" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="Ball：" Foreground="Green"></Label>
                                <TextBlock Width="80" 
                                FontSize="16"
                                           Name="BallPos" 
                                           Foreground="Green"></TextBlock>
                            </WrapPanel>
                        </Grid>



                    </Grid>
                </Grid>
            </Grid>
            <GridSplitter Width="2"  FlowDirection="LeftToRight"/>
            <Grid Grid.Column="1" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70*"/>
                    <RowDefinition Height="40*"/>
                </Grid.RowDefinitions>
                <TabControl Margin="0,0,0,2">
                    <TabItem Header="监视画面">
                        <ContentControl Background="Black" Name="cam"/>
                    </TabItem>
                    <TabItem Header="测试设备">
                        <ContentControl Background="Black" Name="device"></ContentControl>
                    </TabItem>
                    <TabItem Header="通讯测试">
                        <ContentControl Background="Black" Name="ecom"></ContentControl>
                    </TabItem>
                    <TabItem Header="PG测试">
