<Window x:Class="LCD.View.Power"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LCD.View"
        ResizeMode="NoResize"
        mc:Ignorable="d"
        Title="PGView"
        Height="450"
        Width="680" Loaded="Window_Loaded" >
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition  Height="35"/>
                <!--Height="35"-->
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition Height="35" />
                <RowDefinition Height="5" />
            </Grid.RowDefinitions>

            <WrapPanel VerticalAlignment="Center"
                       FlowDirection="RightToLeft">
                <Image Source="../Image/head.png" />
                <Label Content="电源设置"
                       VerticalAlignment="Center"
                       FontSize="20" />
            </WrapPanel>


            <Grid Grid.Row="1">
                <WrapPanel VerticalAlignment="Center" Margin="27,0,0,0">
                    <TextBlock Text="是否启用:"
                               Width="90"
                               FontSize="14"
                               Visibility="Hidden" />
                    <CheckBox IsChecked="{Binding IsCheckBox}" Visibility="Hidden"
                              Margin="1,0,0,0" />
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="2">
                <WrapPanel  VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <Label Content="通信设定："
                           Width="90"
                           FontSize="14"></Label>
                    <Label Content="通信口："
                           Width="80"
                           FontSize="14"></Label>
                    <ComboBox Width="80"
                              FontSize="14"
                              Name="myports"
                              VerticalAlignment="Center"
                              SelectedIndex="{Binding comName}"
                              Text="{Binding comNameText}"></ComboBox>

                    <Label Content="波特率："
                           Margin="20,0,0,0"
                           Width="80"
                           FontSize="14"></Label>
                    <ComboBox Width="80"
                              SelectedIndex="{Binding bardRate}"
                              Text="{Binding bardRateText}"
                              FontSize="14"
                              VerticalAlignment="Center">
                        <ComboBoxItem>9600</ComboBoxItem>
                        <ComboBoxItem>38400</ComboBoxItem>
                        <ComboBoxItem>115200</ComboBoxItem>
                    </ComboBox>
                </WrapPanel>
            </Grid>
            <Grid Grid.Row="3">
                <WrapPanel  VerticalAlignment="Center">
                    <Label Content="数据位："
                           Margin="110,0,0,0"
                           Width="80"
                           FontSize="14"></Label>
                    <ComboBox Width="80"
                              SelectedIndex="{Binding dataBit}"
                              Text="{Binding dataBitText}"
                              FontSize="14"
                              VerticalAlignment="Center">
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>

                    </ComboBox>

                    <Label Content="停止位："
                           Margin="20,0,0,0"
                           Width="80"
                           FontSize="14"></Label>
                    <ComboBox Width="80"
                              SelectedIndex="{Binding stopBit}"
                              Text="{Binding stopBitText}"
                              FontSize="14"
                              VerticalAlignment="Center">
                        <ComboBoxItem>0</ComboBoxItem>
                        <ComboBoxItem>1</ComboBoxItem>
                    </ComboBox>

                    <Label Content="校验位："
                           Margin="20,0,0,0"
                           Width="80"
                           FontSize="14"></Label>
                    <ComboBox Width="80"
                              SelectedIndex="{Binding Parity}"
                              Text="{Binding ParityText}"
                              FontSize="14"
                              VerticalAlignment="Center">
                        <ComboBoxItem>None</ComboBoxItem>
                        <ComboBoxItem>Odd</ComboBoxItem>
                        <ComboBoxItem>Even</ComboBoxItem>
                    </ComboBox>
                </WrapPanel>

            </Grid>
            <Grid Grid.Row="7">
                <WrapPanel FlowDirection="RightToLeft"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Button Content="确定"
                            Click="Button_Click"
                            FontWeight="Bold"
                            FontSize="16"
                            Background="White"
                            Width="120"
                            Height="30"></Button>
                </WrapPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
